{
  "name": "english-collection-dictionary",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/server",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev -w @en-dic/server",
    "dev:web": "npm run dev -w @en-dic/web",
    "build": "npm run build -w @en-dic/shared && npm run build -w @en-dic/web && npm run build -w @en-dic/server",
    "start": "node apps/server/dist/index.js",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p apps/server && tsc --noEmit -p apps/web",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:web": "playwright test",
    "test:docs": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "check": "npm run test:docs && npm test && npm run test:web && npm run typecheck && npm run build",
    "migrate": "node --import tsx scripts/migrate.ts",
    "test:quality": "node --import tsx scripts/quality.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "supabase": "2.119.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
